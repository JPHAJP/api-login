# Environment Configuration
ENVIRONMENT=development  # development o production

# Database Configuration
DATABASE_URL=sqlite:///./site.db
# Para PostgreSQL usar: postgresql://usuario:contraseña@localhost:5432/nombre_db
# Para MySQL usar: mysql://usuario:contraseña@localhost:3306/nombre_db

# JWT Configuration
# ⚠️ IMPORTANTE: Ejecuta 'python generate_secrets.py' para generar secretos seguros
# ⚠️ NO uses los valores por defecto en producción
JWT_SECRET_KEY=GENERA_UN_SECRETO_SEGURO_AQUI
ACCESS_TOKEN_EXPIRES=15
REFRESH_TOKEN_EXPIRES_DAYS=7

# QR Code Configuration
# ⚠️ IMPORTANTE: Usa un secreto diferente al de JWT
QR_ACCESS_SECRET=GENERA_OTRO_SECRETO_SEGURO_AQUI

# Database Encryption (opcional - para el futuro)
DATABASE_ENCRYPTION_KEY=GENERA_OTRO_SECRETO_SEGURO_AQUI

# File Upload Configuration
UPLOAD_FOLDER=data/identificaciones
MAX_FILE_SIZE=5242880